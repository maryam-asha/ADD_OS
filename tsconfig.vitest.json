{
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
		"lib": ["es2023"],
		"types": ["node", "jsdom"],
		"allowImportingTsExtensions": true
	},
	// ADD OS: `src/add-os/assets/__tests__/icons.spec.ts` re-runs the icon scanner from
	// scripts/build-icons.js to prove the generated bundle is not stale, so that file
	// has to be part of this project. `checkJs` stays off — it is only imported, not checked.
	"include": [
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.vue",
		"src/**/*.json",
		"src/**/*.js",
		"scripts/build-icons.js"
	],
	"exclude": []
}
